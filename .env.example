# Required backend configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Keep disabled until the iOS Firebase plist and APNs capability are configured.
IOS_PUSH_NOTIFICATIONS_ENABLED=false

# Online methods remain fail-closed until a reviewed provider adapter exists.
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_ADAPTER=

# Customer support
SUPPORT_EMAIL=

# Published legal documents must use HTTPS URLs.
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
SHIPPING_POLICY_URL=
RETURN_REFUND_POLICY_URL=
